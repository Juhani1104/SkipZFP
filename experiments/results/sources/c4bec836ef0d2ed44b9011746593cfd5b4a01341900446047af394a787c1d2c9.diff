diff --git a/experiments/fetch_basilisk.py b/experiments/fetch_basilisk.py
new file mode 100644
index 0000000..992fd7a
--- /dev/null
+++ b/experiments/fetch_basilisk.py
@@ -0,0 +1,76 @@
+"""Download the SDRBench Basilisk 2D decaying turbulence, the second dataset.
+
+usage: python fetch_basilisk.py <out.zarr> [steps]
+
+The x-velocity u of the 1024 x 1024 run at Re = 10,000, 1501 float32 frames, the first
+member of SDRBench's Basilisk-Turbulence archive. Frame 0 is an all-zero placeholder
+and is skipped; the default keeps the next 1472 frames, a multiple of 64. Unlike the
+ERA5 fields, the velocity is centered on zero and has no daily cycle, so it tests
+pruning on a different distribution. The archive is read as a stream and only up to
+the frames needed, so an interrupted download starts over.
+"""
+
+import sys
+import tarfile
+import time
+import urllib.request
+
+import numpy as np
+import zarr
+
+SRC = (
+    "https://g-d0cd3f.fd635.8443.data.globus.org/raw-data/Basilisk-Turbulence/"
+    "SDRBENCH-Basilisk-Turbulence.tar.gz"
+)
+MEMBER = "SDRBENCH-Basilisk-Turbulence/u_1024x1024x1501Re10k.f32"
+N = 1024
+FRAMES = 1501
+STEP = 64  # frames written at once
+
+
+def main(out, nt):
+    nt = min(nt, FRAMES - 1)
+    frame = N * N * 4
+    root = zarr.open_group(out, mode="w")
+    u = root.create_array(
+        "u",
+        shape=(nt, N, N),
+        chunks=(STEP, N, N),
+        dtype="float32",
+        compressors=None,
+        fill_value=np.nan,
+    )
+    root.create_array("time", data=np.arange(1, nt + 1, dtype=np.float64))
+    root.attrs.update(
+        source=SRC,
+        member=MEMBER,
+        steps=nt,
+        time_unit="simulation frames, frame 0 skipped",
+    )
+    t0 = time.time()
+    with (
+        urllib.request.urlopen(SRC) as resp,
+        tarfile.open(fileobj=resp, mode="r|gz") as tar,
+    ):
+        for m in tar:
+            if m.name != MEMBER:
+                continue
+            f = tar.extractfile(m)
+            f.read(frame)  # the all-zero frame 0
+            for s in range(0, nt, STEP):
+                k = min(STEP, nt - s)
+                x = np.frombuffer(f.read(k * frame), dtype="<f4").reshape(k, N, N)
+                assert np.isfinite(x).all()
+                u[s : s + k] = x
+                print(
+                    f"{s + k}/{nt} frames, {(time.time() - t0) / 60:.1f} min",
+                    flush=True,
+                )
+            break
+        else:
+            raise SystemExit(f"{MEMBER} not found in the archive")
+    print(f"finished: {nt} frames", flush=True)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], int(sys.argv[2]) if len(sys.argv) > 2 else 1472)
diff --git a/experiments/fetch_cmip6.py b/experiments/fetch_cmip6.py
new file mode 100644
index 0000000..80fe566
--- /dev/null
+++ b/experiments/fetch_cmip6.py
@@ -0,0 +1,79 @@
+"""Download 3-hourly CMIP6 precipitation, the second dataset, from the public Pangeo store.
+
+usage: python fetch_cmip6.py <out.zarr> [steps]
+
+HadGEM3-GC31-HM highresSST-present (Met Office, about 25 km), variable pr in
+kg m-2 s-1, region 0-60N, 0-180E (256 x 512 grid points). The first 28800 steps, the
+default, are 2000-2009 in the model's 360-day calendar. Unlike the ERA5 fields,
+precipitation is zero or near zero at most places and heavy in small patches, so it
+tests pruning on a different distribution. Reads are anonymous and the download
+resumes where it stopped.
+"""
+
+import json
+import os
+import sys
+import time
+
+import dask
+import numpy as np
+import xarray as xr
+import zarr
+
+SRC = (
+    "gs://cmip6/CMIP6/HighResMIP/MOHC/HadGEM3-GC31-HM/highresSST-present/"
+    "r1i1p1f1/3hr/pr/gn/v20170831/"
+)
+LAT = slice(384, 640)
+LON = slice(0, 512)
+STEP = 41 * 24  # 24 of the source's 41-step chunks
+
+
+def main(out, nt):
+    done_path = out.rstrip("/") + ".done.json"
+    ds = xr.open_zarr(SRC, storage_options={"token": "anon"}, decode_times=False)
+    pr = ds["pr"].isel(time=slice(0, nt), lat=LAT, lon=LON)
+    nt = pr.sizes["time"]
+    shape = (nt, LAT.stop - LAT.start, LON.stop - LON.start)
+
+    root = zarr.open_group(out, mode="a")
+    if "time" not in root:
+        root.create_array(
+            "pr",
+            shape=shape,
+            chunks=(24, *shape[1:]),
+            dtype="float32",
+            compressors=None,
+            fill_value=np.nan,
+        )
+        root.create_array("time", data=ds.time.values[:nt].astype(np.float64))
+        lat, lon = ds.lat.values[LAT], ds.lon.values[LON]
+        root.attrs.update(
+            source=SRC,
+            steps=nt,
+            time_unit=ds.time.attrs["units"],
+            calendar=ds.time.attrs["calendar"],
+            lat=[float(lat[0]), float(lat[-1])],
+            lon=[float(lon[0]), float(lon[-1])],
+        )
+
+    done = set(json.load(open(done_path))) if os.path.exists(done_path) else set()
+    t0 = time.time()
+    total = -(-nt // STEP)
+    with dask.config.set(scheduler="threads", num_workers=48):
+        for s in range(0, nt, STEP):
+            if s in done:
+                continue
+            x = np.asarray(pr.isel(time=slice(s, s + STEP)).data.compute())
+            assert np.isfinite(x).all()
+            root["pr"][s : s + len(x)] = x.astype(np.float32)
+            done.add(s)
+            json.dump(sorted(done), open(done_path, "w"))
+            if len(done) % 5 == 0 or len(done) == total:
+                minutes = (time.time() - t0) / 60
+                print(f"{len(done)}/{total} blocks, {minutes:.1f} min", flush=True)
+    print(f"finished: {nt} steps", flush=True)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], int(sys.argv[2]) if len(sys.argv) > 2 else 28800)
